# Appwrite (Console → your project → Overview / Settings)
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# Must match the iOS bundleIdentifier / Android package registered as a platform in Appwrite
EXPO_PUBLIC_APPWRITE_PLATFORM=

# These match scripts/setup-appwrite.mjs; change only if you renamed them
EXPO_PUBLIC_APPWRITE_DB_ID=
EXPO_PUBLIC_APPWRITE_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_FUNCTION_ID=

# Never put YOUCAM_API_KEY or MASTER_KEK here. Anything starting with EXPO_PUBLIC_
# is bundled into the app. Those secrets go in the Appwrite Function's settings.

# youcam API
YOUCAM_API_KEY=
YOUCAM_BASE_URL=
